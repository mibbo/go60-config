#!/usr/bin/env bash
# Install this repo's tools on this machine (safe to re-run):
#   ~/.local/bin/go60-flash, go60-build, go60-keys, go60-keymap, go60-leds, go60-ui, go60-status -> commands on PATH
#   ~/.claude/skills/go60                            -> the Claude Code skill
#   ~/.local/share/applications/go60.desktop         -> "Go60" in the app launcher (runs go60-ui --app)
# Everything else is a symlink into the repo, so `git pull` updates it all.

set -euo pipefail
REPO_DIR=$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")

link() { # target link
  mkdir -p "$(dirname "$2")"
  if [[ -e $2 && ! -L $2 ]]; then
    echo "skip: $2 exists and is not a symlink" >&2
    return
  fi
  ln -sfn "$1" "$2"
  echo "$2 -> $1"
}

link "$REPO_DIR/scripts/go60-flash" "$HOME/.local/bin/go60-flash"
link "$REPO_DIR/skills/go60/scripts/go60-keys" "$HOME/.local/bin/go60-keys"
link "$REPO_DIR/skills/go60/scripts/go60-status" "$HOME/.local/bin/go60-status"
link "$REPO_DIR/skills/go60/scripts/go60-keymap" "$HOME/.local/bin/go60-keymap"
link "$REPO_DIR/skills/go60/scripts/go60-leds" "$HOME/.local/bin/go60-leds"
link "$REPO_DIR/skills/go60/scripts/go60-ui" "$HOME/.local/bin/go60-ui"
link "$REPO_DIR/scripts/go60-build" "$HOME/.local/bin/go60-build"
link "$REPO_DIR/skills/go60" "$HOME/.claude/skills/go60"

# App launcher entry (Omarchy's Super+Space menu): opens the Go60 app window, like Super+Shift+K.
mkdir -p "$HOME/.local/share/applications"
cat >"$HOME/.local/share/applications/go60.desktop" <<DESKTOP
[Desktop Entry]
Version=1.0
Name=Go60
Comment=Go60 keyboard cheat sheet and LED colour editor
Exec=$HOME/.local/bin/go60-ui --app
Terminal=false
Type=Application
Icon=input-keyboard
Categories=Utility;
StartupNotify=true
DESKTOP
echo "$HOME/.local/share/applications/go60.desktop (Go60 in the app launcher)"

# Old name of the layout viewer (replaced by `go60-keys show`).
[[ -L $HOME/.local/bin/go60-layout ]] && rm "$HOME/.local/bin/go60-layout" && echo "removed old go60-layout link"

"$REPO_DIR/skills/go60/scripts/go60-keys" cheatsheet >/dev/null && echo "cheat sheet: go60-keys cheatsheet --open (or go60-ui for the app with the LED editor)"
