#!/usr/bin/env python3
"""go60-leds: per-key LED colour presets for the Go60.

Presets live in config/led-presets.json (one colour per key). go60-build turns them into firmware
lighting effects that come after MoErgo's four (Solid, Breathe, Spectrum, Swirl), so Magic + LH C1R3
(next effect) cycles through them.

  go60-leds edit [--no-open] [--port N]   open the colour editor in the browser (saves to the repo)
  go60-leds list                          the presets and their effect numbers
  go60-leds check                         validate config/led-presets.json
  go60-leds header [-o FILE]              write the C header the firmware build uses (go60-build does this)
"""

import argparse
import http.server
import json
import os
import re
import secrets
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import keymap as km  # noqa: E402

PRESETS_FILE = Path(os.environ.get("GO60_LED_PRESETS") or km.REPO_DIR / "config" / "led-presets.json")
STOCK_EFFECTS = ["Solid", "Breathe", "Spectrum", "Swirl"]
MAX_PRESETS = 16
HEX = re.compile(r"^#[0-9a-fA-F]{6}$")
NAMES = [km.position_name(i) for i in range(60)]


# ------------------------------------------------------------- presets ---

def validate(data):
    """Return the normalized presets list, or raise ValueError."""
    if not isinstance(data, dict) or not isinstance(data.get("presets"), list):
        raise ValueError('expected {"presets": [...]}')
    presets = data["presets"]
    if len(presets) > MAX_PRESETS:
        raise ValueError(f"at most {MAX_PRESETS} presets")
    out, seen = [], set()
    for n, p in enumerate(presets, 1):
        name = str(p.get("name", "")).strip() if isinstance(p, dict) else ""
        if not name:
            raise ValueError(f"preset {n} has no name")
        if name.lower() in seen:
            raise ValueError(f"two presets are called {name!r}")
        seen.add(name.lower())
        keys = p.get("keys", {})
        if not isinstance(keys, dict):
            raise ValueError(f"{name}: keys must be an object")
        for k, c in keys.items():
            if k not in NAMES:
                raise ValueError(f"{name}: unknown key position {k!r} (e.g. 'LH C3R2', 'RH T1')")
            if not isinstance(c, str) or not HEX.match(c):
                raise ValueError(f"{name}: {k} colour {c!r} is not like #ff8800")
        # Keys left out are off. Store every key, in keyboard order, so diffs stay readable.
        out.append({"name": name, "keys": {k: keys.get(k, "#000000").lower() for k in NAMES}})
    return out


def load():
    if not PRESETS_FILE.exists():
        return []
    with open(PRESETS_FILE, encoding="utf-8") as f:
        return validate(json.load(f))


def save(presets):
    text = json.dumps({"presets": presets}, indent=2, ensure_ascii=False) + "\n"
    tmp = PRESETS_FILE.with_suffix(".json.tmp")
    tmp.write_text(text, encoding="utf-8")
    tmp.replace(PRESETS_FILE)


def rgb(hexcolor):
    return tuple(int(hexcolor[i:i + 2], 16) for i in (1, 3, 5))


def header(presets):
    lines = ["// Generated by go60-leds from config/led-presets.json. Don't edit.", "#pragma once", "",
             "#include <zephyr/drivers/led_strip.h>", "",
             f"#define GO60_LED_PRESET_COUNT {len(presets)}",
             f"#define GO60_LED_PRESET_PIXELS {km.LEDS_PER_HALF}", ""]
    if not presets:
        return "\n".join(lines) + "\n"
    for side, cond in (("L", "#if IS_ENABLED(CONFIG_BOARD_GO60_LH)"), ("R", "#else")):
        lines.append(cond)
        lines.append(f"static const struct led_rgb go60_led_presets[{len(presets)}][{km.LEDS_PER_HALF}] = {{")
        for p in presets:
            leds = [(0, 0, 0)] * km.LEDS_PER_HALF
            for i in range(60):
                s, led = km.led_index(i)
                if s == side:
                    leds[led] = rgb(p["keys"][NAMES[i]])
            cells = ", ".join(f"{{.r = {r}, .g = {g}, .b = {b}}}" for r, g, b in leds)
            name = p["name"].replace("*/", "* /")
            lines.append(f"    /* {name} */ {{{cells}}},")
        lines.append("};")
    lines.append("#endif")
    return "\n".join(lines) + "\n"


def effect_list(presets):
    return STOCK_EFFECTS + [p["name"] for p in presets]


# -------------------------------------------------------------- editor ---

def editor_data(presets):
    try:
        L = km.Layout(km.load_layout())
        labels = [L.describe(b)["label"] for b in L.layers[0]]
    except (OSError, ValueError, KeyError, IndexError):
        labels = [""] * 60
    keys = [{"i": i, "pos": NAMES[i], "where": km.position_words(i), "finger": km.finger(i), "label": labels[i],
             "p": list(km.POSITIONS[i])} for i in range(60)]
    return {"keys": keys, "presets": presets, "stock": STOCK_EFFECTS, "max": MAX_PRESETS,
            "file": str(PRESETS_FILE.relative_to(km.REPO_DIR)) if PRESETS_FILE.is_relative_to(km.REPO_DIR)
            else str(PRESETS_FILE)}


def serve(port, open_it):
    token = secrets.token_urlsafe(16)
    template = (km.SKILL_DIR / "assets" / "leds.html").read_text(encoding="utf-8")

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def reply(self, code, body, ctype="application/json"):
            data = body.encode("utf-8")
            self.send_response(code)
            self.send_header("Content-Type", f"{ctype}; charset=utf-8")
            self.send_header("Content-Length", str(len(data)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            if self.path not in ("/", "/index.html"):
                return self.reply(404, '{"error": "not found"}')
            try:
                presets = load()
            except (OSError, ValueError) as e:
                return self.reply(500, f"<p>Can't read {PRESETS_FILE}: {e}</p>", "text/html")
            data = json.dumps(editor_data(presets), ensure_ascii=False).replace("</", "<\\/")
            page = template.replace("/*__GO60_DATA__*/null", data).replace("__GO60_TOKEN__", token)
            self.reply(200, page, "text/html")

        def do_POST(self):
            # Only the page we served may save: other sites can't read the token.
            if self.path != "/api/presets" or self.headers.get("X-Go60-Token") != token:
                return self.reply(403, '{"error": "forbidden"}')
            try:
                n = int(self.headers.get("Content-Length", 0))
                presets = validate(json.loads(self.rfile.read(n)))
                save(presets)
            except (ValueError, json.JSONDecodeError) as e:
                return self.reply(400, json.dumps({"error": str(e)}))
            print(f"Saved {len(presets)} preset(s) to {PRESETS_FILE}")
            self.reply(200, json.dumps({"ok": True, "effects": effect_list(presets)}))

    httpd = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
    url = f"http://127.0.0.1:{httpd.server_address[1]}/"
    print(f"Go60 LED editor: {url}\nSaves go to {PRESETS_FILE}. Press Ctrl+C here when you're done.")
    if open_it:
        subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nEditor closed. Put the presets on the keyboard with: go60-build")


# ---------------------------------------------------------------- main ---

def main():
    ap = argparse.ArgumentParser(prog="go60-leds", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("edit")
    p.add_argument("--port", type=int, default=0, help="port on 127.0.0.1 (default: any free one)")
    p.add_argument("--no-open", action="store_true", help="don't open the browser")
    sub.add_parser("list")
    sub.add_parser("check")
    sub.add_parser("names")
    p = sub.add_parser("header")
    p.add_argument("-o", "--output", help="file to write (default: stdout)")
    args = ap.parse_args()

    try:
        presets = load()
    except (OSError, ValueError, json.JSONDecodeError) as e:
        sys.exit(f"go60-leds: {PRESETS_FILE}: {e}")

    if args.cmd == "edit":
        serve(args.port, not args.no_open)
    elif args.cmd == "list":
        for n, name in enumerate(effect_list(presets)):
            print(f"  {n}  {name}{'' if n < len(STOCK_EFFECTS) else '  (preset)'}")
        print("Magic (LH C6R4) + LH C1R3 switches to the next effect.")
    elif args.cmd == "names":
        print(", ".join(p["name"] for p in presets) or "(none)")
    elif args.cmd == "check":
        print(f"OK: {len(presets)} preset(s) in {PRESETS_FILE}")
    elif args.cmd == "header":
        text = header(presets)
        if args.output:
            Path(args.output).write_text(text, encoding="utf-8")
        else:
            sys.stdout.write(text)


if __name__ == "__main__":
    main()
