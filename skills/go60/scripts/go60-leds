#!/usr/bin/env python3
"""go60-leds: per-key LED colour presets for the Go60.

Presets live in config/led-presets.json (one colour per key). go60-build turns them into firmware
lighting effects that come after MoErgo's four (Solid, Breathe, Spectrum, Swirl), so Magic + LH C1R3
(next effect) cycles through them.

  go60-leds edit [--no-open] [--port N]   open the Go60 app on its Lights tab (same as go60-ui --lights)
  go60-leds list                          the presets and their effect numbers
  go60-leds names                         preset names on one line
  go60-leds check                         validate config/led-presets.json
  go60-leds header [-o FILE]              write the C header the firmware build uses (go60-build does this)
"""

import argparse
import json
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import app  # noqa: E402
import leds  # noqa: E402


def main():
    ap = argparse.ArgumentParser(prog="go60-leds", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("edit")
    p.add_argument("--port", type=int, default=0, help="port on 127.0.0.1 (default: any free one)")
    p.add_argument("--no-open", action="store_true", help="don't open the browser")
    sub.add_parser("list")
    sub.add_parser("names")
    sub.add_parser("check")
    p = sub.add_parser("header")
    p.add_argument("-o", "--output", help="file to write (default: stdout)")
    args = ap.parse_args()

    try:
        presets = leds.load()
    except (OSError, ValueError, json.JSONDecodeError) as e:
        sys.exit(f"go60-leds: {leds.PRESETS_FILE}: {e}")

    if args.cmd == "edit":
        app.serve(args.port, not args.no_open, tab="lights")
    elif args.cmd == "list":
        for n, name in enumerate(leds.effect_list(presets)):
            print(f"  {n}  {name}{'' if n < len(leds.STOCK_EFFECTS) else '  (preset)'}")
        print("Magic (LH C6R4) + LH C1R3 switches to the next effect.")
    elif args.cmd == "names":
        print(", ".join(p["name"] for p in presets) or "(none)")
    elif args.cmd == "check":
        print(f"OK: {len(presets)} preset(s) in {leds.PRESETS_FILE}")
    elif args.cmd == "header":
        text = leds.header(presets)
        if args.output:
            Path(args.output).write_text(text, encoding="utf-8")
        else:
            sys.stdout.write(text)


if __name__ == "__main__":
    main()
