#!/usr/bin/env python3
"""go60-keys: answer questions about the flashed Go60 layout (layout/current.json).

  go60-keys find TEXT...        where is a character, key or function?
                                  e.g.  find å   find '{'   find enter   find UP   find bootloader
  go60-keys key POSITION...     what a key does on every layer (0-59, or 'LH T1', 'RH C3R2')
  go60-keys layers              list the layers and how to reach each one
  go60-keys show [LAYER...]     draw layers as the physical keyboard, with Finnish legends
  go60-keys cheatsheet [--open] [-o FILE]
                                write the cheat sheet (the Go60 app page as a read-only file;
                                go60-ui serves it with the LED editor tab too)

Options: --file PATH (another layout JSON export), --all (include the factory test layer)
Legends are what the keys type with the Finnish (fi) keyboard layout.
"""

import argparse
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
import app  # noqa: E402
import keymap as km  # noqa: E402

WORDS = {
    "enter": ["RET", "KP_ENTER"], "return": ["RET"], "backspace": ["BSPC"], "bspc": ["BSPC"],
    "delete": ["DEL"], "del": ["DEL"], "space": ["SPACE"], "spacebar": ["SPACE"], "tab": ["TAB"],
    "esc": ["ESC"], "escape": ["ESC"], "shift": ["LSHFT", "RSHFT"], "ctrl": ["LCTRL", "RCTRL"],
    "control": ["LCTRL", "RCTRL"], "alt": ["LALT"], "altgr": ["RALT"], "super": ["LGUI", "RGUI"],
    "win": ["LGUI", "RGUI"], "windows": ["LGUI", "RGUI"], "gui": ["LGUI", "RGUI"],
    "up": ["UP"], "down": ["DOWN"], "left": ["LEFT"], "right": ["RIGHT"],
    "arrows": ["UP", "DOWN", "LEFT", "RIGHT"], "home": ["HOME"], "end": ["END"],
    "pageup": ["PG_UP"], "pagedown": ["PG_DN"], "pgup": ["PG_UP"], "pgdn": ["PG_DN"],
    "insert": ["INS"], "capslock": ["CAPS"], "caps": ["CAPS"], "printscreen": ["PSCRN"],
    "menu": ["K_APP"], "numlock": ["KP_NUM"],
    "volume": ["C_VOL_UP", "C_VOL_DN", "C_MUTE"], "mute": ["C_MUTE"],
    "play": ["C_PP"], "pause": ["C_PP"], "brightness": ["C_BRI_UP", "C_BRI_DN"],
}
BEHAVIORS = {
    "bootloader": ["&bootloader"], "flash": ["&bootloader"], "reset": ["&reset"],
    "bluetooth": ["&bt", "&bt_0", "&bt_1", "&bt_2", "&bt_3"], "bt": ["&bt", "&bt_0", "&bt_1", "&bt_2", "&bt_3"],
    "usb": ["&out"], "output": ["&out"], "rgb": ["&rgb_ug"], "lights": ["&rgb_ug"], "magic": ["&magic"],
}
LEVEL_WORDS = {1: "Shift", 2: "AltGr", 3: "Shift + AltGr"}


def base_name(L, i):
    """The key's name on the base layer (e.g. 'x', 'Magic'), the easy way to spot it on the keyboard."""
    label = L.describe(L.layers[0][i])["label"]
    return label if label and label not in ("·", "▽") else "blank"


def where(L, i):
    return f"{km.position_name(i)} ({base_name(L, i)} key): {km.position_words(i)}  [index {i}]"


def layer_heading(L, l):
    if l == 0:
        return f"{L.names[0]} layer (layer 0, always active)"
    return f"{L.names[l]} layer (layer {l})"


def reach_lines(L, l, indent="      "):
    if l == 0:
        return []
    ways = [w for w in L.reach(l) if w[0] == 0] or L.reach(l)[:2]
    if not ways:
        return [f"{indent}(no key on the other layers switches to this layer)"]
    lines = []
    for src, i, how in ways:
        from_txt = "" if src == 0 else f" (from the {L.names[src]} layer)"
        lines.append(f"{indent}To get there: {how}{from_txt}: {where(L, i)}")
    return lines


def find(L, query, include_test):
    q = query.strip() if query.strip() else query
    layers = [l for l in range(len(L.layers)) if include_test or not L.is_test_layer(l)]
    print()

    # A single character: search by what it types with the Finnish layout.
    if len(q) == 1:
        targets = km.char_targets(q)
        if not targets:
            print(f"{q!r}: can't be typed with a single key combination on the Finnish layout"
                  " (it may need a dead key, Compose or a macro).")
            return
        ways = []
        for c, lv in targets:
            name = f"keypad {q}" if c.startswith("KP_") else km.key_label(c, set()) if lv else f"the {q} key"
            w = ("" if lv == 0 else LEVEL_WORDS[lv] + " + ") + name + (" (dead key)" if (c, lv) in km.DEAD else "")
            if w not in ways:
                ways.append(w)
        how = " or ".join(ways)
        print(f"{q}   (Finnish layout: {how})")
        hits = []
        for l, i, mods, code in km.char_ways(L, q, include_test):
            if not mods:
                hits.append((l, i, 0, f"types {q} directly ({L.describe(L.layers[l][i])['zmk']})"))
            else:
                lv = next(lv for lv, m in km.LEVEL_MODS.items() if m == mods)
                hits.append((l, i, 1, f"hold {LEVEL_WORDS[lv]} and press this key (it types {km.key_label(code, set())})"))
        print_hits(L, hits, extra_mods={m for _, lv in targets for m in km.LEVEL_MODS[lv]})
        return

    key = q.lower().replace(" ", "").replace("-", "").replace("_", "")
    # A named function (bootloader, bluetooth, ...).
    if key in BEHAVIORS:
        hits = [(l, i, 0, L.describe(b)["text"]) for l in layers for i, b in enumerate(L.layers[l])
                if b.get("value") in BEHAVIORS[key]]
        print(f"{query}")
        print_hits(L, hits)
        return

    # A key name (enter, shift, UP, BSPC, LS(N7) ...).
    codes = WORDS.get(key)
    if codes is None:
        codes = [km.canonical(q.upper())[0]]
    mod_names = {km.MOD_KEYS[c] for c in codes if c in km.MOD_KEYS}
    hits = []
    for l in layers:
        for i, b in enumerate(L.layers[l]):
            d = L.describe(b)
            if any(code in codes for code, _ in d["taps"]):
                hits.append((l, i, 0, d["text"] or d["zmk"]))
            elif mod_names & set(d["holds"]):
                hits.append((l, i, 1, d["text"]))
    print(f"{query}   ({', '.join(codes)})")
    print_hits(L, hits)


def print_hits(L, hits, extra_mods=()):
    if not hits:
        print("  Not found on any layer.")
        return
    seen = set()
    for l in sorted({h[0] for h in hits}):
        print(f"  {layer_heading(L, l)}")
        for _, i, _, text in sorted((h for h in hits if h[0] == l), key=lambda h: (h[2], h[1])):
            if (l, i, text) in seen:
                continue
            seen.add((l, i, text))
            print(f"    • {where(L, i)}")
            print(f"      {text}")
        for line in reach_lines(L, l):
            print(line)
    for mod in sorted(extra_mods):
        keys = km.modifier_keys(L, mod)
        if keys:
            locs = "; ".join(f"{km.position_name(i)} ({km.position_words(i)}): {d['text']}" for i, d in keys)
            print(f"  {km.MOD_LABEL[mod]} is on the base layer at {locs}")
        else:
            print(f"  No {km.MOD_LABEL[mod]} key on the base layer.")


def key_info(L, text, include_test):
    i = km.parse_position(text)
    print()
    print(where(L, i))
    for l in range(len(L.layers)):
        if L.is_test_layer(l) and not include_test:
            continue
        d = L.describe(L.layers[l][i])
        extra = ""
        if d["kind"] == "trans":
            _, eff = L.effective(l, i)
            extra = f"  → {eff['text']}"
        print(f"  {L.names[l]:<12} {d['zmk']:<22} {d['text']}{extra}")


def list_layers(L):
    print()
    for l, name in enumerate(L.names):
        print(f"{l}: {name}" + ("  (factory switch-test layer, not for typing)" if L.is_test_layer(l) else ""))
        if l == 0:
            print("     the default layer, always active")
        for line in reach_lines(L, l, indent="     "):
            print(line)


# ---------------------------------------------------------- text drawing ---

LEFT_COLS = [6, 5, 4, 3, 2, 1]


def index_at(side, kind, n, row):
    for i, p in km.POSITIONS.items():
        if p == (side, kind, n, row):
            return i
    return None


def show(L, which, include_test):
    layers = [L.layer_index(w) for w in which] if which else \
        [l for l in range(len(L.layers)) if include_test or not L.is_test_layer(l)]
    for l in layers:
        labels = {i: L.describe(b)["label"] or "·" for i, b in enumerate(L.layers[l])}
        w = min(9, max(5, max(len(s) for s in labels.values())))

        def cell(i):
            s = labels[i] if i is not None else ""
            return (s if len(s) <= w else s[:w - 1] + "…").center(w)
        print()
        print(f"== {L.names[l]} (layer {l}) ==   ▽ = same as base layer, · = nothing")
        for row in range(1, 6):
            left = [index_at("L", "C", c, row) for c in LEFT_COLS]
            right = [index_at("R", "C", c, row) for c in reversed(LEFT_COLS)]
            print(" ".join(cell(i) for i in left) + "   ║   " + " ".join(cell(i) for i in right))
        lt = [index_at("L", "T", t, None) for t in (3, 2, 1)]
        rt = [index_at("R", "T", t, None) for t in (1, 2, 3)]
        pad = " " * ((w + 1) * 3)
        print(pad + " ".join(cell(i) for i in lt) + "   ║   " + " ".join(cell(i) for i in rt))
        print(" " * ((w + 1) * 3) + "(thumbs T3 T2 T1)".center((w + 1) * 3) + "       " +
              "(thumbs T1 T2 T3)".center((w + 1) * 3))


# ------------------------------------------------------------ cheat sheet ---

def cheatsheet(L, out, open_it):
    """The Go60 app page as a read-only file: the Cheat sheet tab, with the LED presets on the keys."""
    out = Path(out).expanduser()
    app.write_static(L, out)
    print(out)
    if open_it:
        app.open_in_browser(out)


def default_cheatsheet_path():
    cache = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    return Path(cache) / "go60" / "cheatsheet.html"


def main():
    ap = argparse.ArgumentParser(prog="go60-keys", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--file", help="layout JSON export (default: layout/current.json in the go60-config repo)")
    ap.add_argument("--all", action="store_true", help="include the factory test layer")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("find"); p.add_argument("text", nargs="+")
    p = sub.add_parser("key"); p.add_argument("position", nargs="+")
    sub.add_parser("layers")
    p = sub.add_parser("show"); p.add_argument("layer", nargs="*")
    p = sub.add_parser("cheatsheet")
    p.add_argument("-o", "--output", default=str(default_cheatsheet_path()))
    p.add_argument("--open", action="store_true")
    args = ap.parse_args()

    try:
        L = km.Layout(km.load_layout(args.file))
    except FileNotFoundError as e:
        sys.exit(f"go60-keys: no layout file ({e.filename}). Flash with go60-flash and a JSON export first.")
    try:
        if args.cmd == "find":
            for t in args.text:
                find(L, t, args.all)
        elif args.cmd == "key":
            for t in args.position:
                key_info(L, t, args.all)
        elif args.cmd == "layers":
            list_layers(L)
        elif args.cmd == "show":
            show(L, args.layer, args.all)
        elif args.cmd == "cheatsheet":
            cheatsheet(L, args.output, args.open)
    except ValueError as e:
        sys.exit(f"go60-keys: {e}")


if __name__ == "__main__":
    main()
