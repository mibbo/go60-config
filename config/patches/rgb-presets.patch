 struct rgb_underglow_state {
@@ -190,6 +195,18 @@
     state.animation_step = state.animation_step % HUE_MAX;
 }
 
+// go60-config: show a preset's per-key colours, scaled by the brightness setting
+static void zmk_rgb_underglow_effect_preset(int preset) {
+#if GO60_LED_PRESET_COUNT > 0
+    BUILD_ASSERT(GO60_LED_PRESET_PIXELS == STRIP_NUM_PIXELS, "LED presets don't match the LED count");
+    int b = hsb_scale_min_max(state.color).b;
+    for (int i = 0; i < STRIP_NUM_PIXELS; i++) {
+        const struct led_rgb c = go60_led_presets[preset][i];
+        pixels[i] = (struct led_rgb){r : c.r * b / BRT_MAX, g : c.g * b / BRT_MAX, b : c.b * b / BRT_MAX};
+    }
+#endif
+}
+
 static int zmk_led_generate_status(void);
 
 static void zmk_led_write_pixels(void) {
@@ -433,6 +450,15 @@
     case UNDERGLOW_EFFECT_SWIRL:
         zmk_rgb_underglow_effect_swirl();
         break;
+    default:
+        if (state.current_effect < UNDERGLOW_EFFECT_NUMBER) {
+            zmk_rgb_underglow_effect_preset(state.current_effect - UNDERGLOW_EFFECT_PRESETS);
+        } else {
+            // A saved effect whose preset was removed since: fall back to solid
+            state.current_effect = UNDERGLOW_EFFECT_SOLID;
+            zmk_rgb_underglow_effect_solid();
+        }
+        break;
     }
 
     zmk_led_write_pixels();
