/*
 * Go60 keymap: edit this file to change the layout, then run `go60-build` and `go60-flash`.
 * Started from the Layout Editor layout "Factory Default Layout" (49ea1794).
 *
 * Each layer's bindings are laid out like the keyboard, one text row per key row:
 *   R1-R4  left half C6 C5 C4 C3 C2 C1  |  right half C1 C2 C3 C4 C5 C6
 *          (C1 = inner index-finger column, C6 = outer pinky column; R1 = number row, R3 = home row)
 *   R5     the extra bottom keys: left C4 C3 C2  |  right C2 C3 C4
 *   T      thumb keys, in this order: left T1 T2 T3  |  right T3 T2 T1  (T1 = innermost)
 *
 * The // line under each row shows what the keys type with the Finnish layout (▽ = same as the base
 * layer, · = nothing). It's a comment for reading only; `go60-keymap format` refreshes it after edits.
 *
 * Every layer needs exactly 60 bindings. Common ones:
 *   &kp X            press key X (US key names: &kp LBKT types å with the Finnish layout)
 *   &kp RA(N7)       AltGr+7 = {     &kp LS(N7) = Shift+7 = /     (see go60-keys / finnish-layout.md)
 *   &mt LCTRL A      tap: A, hold: Ctrl          &mo LAYER_X   layer X while held
 *   &td_LAYER_X      hold: layer X, double-tap: lock layer X     &to LAYER_X   switch to layer X
 *   &trans           same as the layer below     &none         nothing
 *
 * Check your edits with `go60-keymap check` (validates and lists what changed since the last flash).
 * Put your own behaviors and macros in the "custom behaviors" section, not in the generated ones.
 */

#include <behaviors.dtsi>

#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/input_transform.h>
#include <dt-bindings/zmk/pointing.h>

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>

// Layers (the number is the layer's position in the keymap below)
#define LAYER_Base 0
#define LAYER_Keypad 1
#define LAYER_SymbolNav 2
#define LAYER_Magic 3
#define LAYER_Factory 4

/ {
    input_processors {
        zip_click_to_right_click_mapper: zip_click_to_right_click_mapper {
            compatible = "zmk,input-processor-code-mapper";
            #input-processor-cells = <0>;
            type = <INPUT_EV_KEY>;
            map = <INPUT_BTN_0 INPUT_BTN_1>;
        };
    };

    // Standard MoErgo behaviors (generated; the Layout Editor provides these itself)
    behaviors {
        // Magic key: hold for the Magic layer, tap to show status on the RGB LEDs
        magic: magic {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            bindings = <&mo>, <&rgb_ug_status_macro>;
        };

        // &td_LAYER_Keypad: hold for the Keypad layer, double-tap to lock it on
        td_LAYER_Keypad: td_LAYER_Keypad {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo LAYER_Keypad>, <&to LAYER_Keypad>;
        };

        // &td_LAYER_SymbolNav: hold for the SymbolNav layer, double-tap to lock it on
        td_LAYER_SymbolNav: td_LAYER_SymbolNav {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mo LAYER_SymbolNav>, <&to LAYER_SymbolNav>;
        };

        // &bt_0: tap to use Bluetooth profile 0, double-tap to disconnect it
        bt_0: bt_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_0>, <&bt BT_DISC 0>;
        };

        // &bt_1: tap to use Bluetooth profile 1, double-tap to disconnect it
        bt_1: bt_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_1>, <&bt BT_DISC 1>;
        };

        // &bt_2: tap to use Bluetooth profile 2, double-tap to disconnect it
        bt_2: bt_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_2>, <&bt BT_DISC 2>;
        };

        // &bt_3: tap to use Bluetooth profile 3, double-tap to disconnect it
        bt_3: bt_3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&bt_select_3>, <&bt BT_DISC 3>;
        };
    };

    macros {
        rgb_ug_status_macro: rgb_ug_status_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&rgb_ug RGB_STATUS>;
        };

        bt_select_0: bt_select_0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 0>;
        };

        bt_select_1: bt_select_1 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 1>;
        };

        bt_select_2: bt_select_2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 2>;
        };

        bt_select_3: bt_select_3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&out OUT_BLE>, <&bt BT_SEL 3>;
        };
    };
};

/* go60-config: custom behaviors (kept when converting to Layout Editor JSON) */

/* go60-config: end of custom behaviors */

/ {
    keymap {
        compatible = "zmk,keymap";

        layer_Base {
            display-name = "Base";
            bindings = <
            /*    left  C6 C5 C4 C3 C2 C1  |  right C1 C2 C3 C4 C5 C6  (thumbs: left T1 T2 T3 | right T3 T2 T1) */
            /* R1 */ &kp EQUAL            &kp N1 &kp N2    &kp N3              &kp N4    &kp N5       &kp N6   &kp N7    &kp N8       &kp N9   &kp N0   &kp MINUS
            //       ´                    1      2         3                   4         5            6        7         8            9        0        +
            /* R2 */ &kp TAB              &kp Q  &kp W     &kp E               &kp R     &kp T        &kp Y    &kp U     &kp I        &kp O    &kp P    &kp BSLH
            //       Tab                  q      w         e                   r         t            y        u         i            o        p        '
            /* R3 */ &kp ESC              &kp A  &kp S     &kp D               &kp F     &kp G        &kp H    &kp J     &kp K        &kp L    &kp SEMI &kp SQT
            //       Esc                  a      s         d                   f         g            h        j         k            l        ö        ä
            /* R4 */ &magic LAYER_Magic 0 &kp Z  &kp X     &kp C               &kp V     &kp B        &kp N    &kp M     &kp COMMA    &kp DOT  &kp FSLH &td_LAYER_Keypad
            //       Magic                z      x         c                   v         b            n        m         ,            .        -        Keypad
            /* R5 */                             &kp GRAVE &kp DEL             &kp BSPC                        &kp LGUI  &kp LBKT     &kp RBKT
            //                                   §         Delete              Backspace                       Super     å            ¨
            /* T  */                                       &td_LAYER_SymbolNav &kp LSHFT &kp LCTRL    &kp LALT &kp SPACE &mt RALT RET
            //                                             SymbolNav           Shift     Ctrl         Alt      Space     Enter/AltGr
            >;
        };

        layer_Keypad {
            display-name = "Keypad";
            bindings = <
            /*    left  C6 C5 C4 C3 C2 C1  |  right C1 C2 C3 C4 C5 C6  (thumbs: left T1 T2 T3 | right T3 T2 T1) */
            /* R1 */ &none                &kp F1    &kp F2    &kp F3              &kp F4    &kp F5           &kp F6    &kp F7    &kp F8     &kp F9         &kp F10         &kp F11
            //       ·                    F1        F2        F3                  F4        F5               F6        F7        F8         F9             F10             F11
            /* R2 */ &trans               &none     &kp HOME  &kp UP              &kp END   &kp PG_UP        &kp KP_N7 &kp KP_N8 &kp KP_N9  &kp KP_MINUS   &kp KP_SLASH    &kp F12
            //       ▽                    ·         Home      ↑                   End       PgUp             7         8         9          -              /               F12
            /* R3 */ &trans               &kp LC(Y) &kp LEFT  &kp DOWN            &kp RIGHT &kp PG_DN        &kp KP_N4 &kp KP_N5 &kp KP_N6  &kp KP_PLUS    &kp KP_MULTIPLY &kp KP_NUM
            //       ▽                    Ctrl+Y    ←         ↓                   →         PgDn             4         5         6          +              *               Num_Lock
            /* R4 */ &magic LAYER_Magic 0 &kp LC(Z) &kp LC(X) &kp LC(C)           &kp LC(V) &kp LS(LC(V))    &kp KP_N1 &kp KP_N2 &kp KP_N3  &kp KP_ENTER   &kp EQUAL       &to LAYER_Base
            //       Magic                Ctrl+Z    Ctrl+X    Ctrl+C              Ctrl+V    Ctrl+Shift+V     1         2         3          Enter_(keypad) ´               Base
            /* R5 */                                &none     &trans              &trans                               &kp KP_N0 &kp KP_DOT &kp BSPC
            //                                      ·         ▽                   ▽                                    0         ,          Backspace
            /* T  */                                          &mo LAYER_SymbolNav &trans    &trans           &trans    &trans    &kp KP_N0
            //                                                SymbolNav           ▽         ▽                ▽         ▽         0
            >;
        };

        layer_SymbolNav {
            display-name = "SymbolNav";
            bindings = <
            /*    left  C6 C5 C4 C3 C2 C1  |  right C1 C2 C3 C4 C5 C6  (thumbs: left T1 T2 T3 | right T3 T2 T1) */
            /* R1 */ &kp INS              &kp F1     &kp F2     &kp F3         &kp F4       &kp F5          &kp F6     &kp F7     &kp F8          &kp F9        &kp F10         &kp F11
            //       Insert               F1         F2         F3             F4           F5              F6         F7         F8              F9            F10             F11
            /* R2 */ &kp SLCK             &kp LS(N1) &kp HOME   &kp UP         &kp END      &kp PG_UP       &kp LS(N9) &kp LS(N0) &kp UP          &kp LS(N5)    &kp K_APP       &kp F12
            //       Scroll_Lock          !          Home       ↑              End          PgUp            )          =          ↑               %             Menu            F12
            /* R3 */ &kp CAPS             &kp LS(N2) &kp LEFT   &kp DOWN       &kp RIGHT    &kp PG_DN       &kp LS(N4) &kp LEFT   &kp DOWN        &kp RIGHT     &kp PAUSE_BREAK &kp PSCRN
            //       Caps_Lock            "          ←          ↓              →            PgDn            ¤          ←          ↓               →             Pause           PrtSc
            /* R4 */ &magic LAYER_Magic 0 &kp LS(N3) &kp LBKT   &kp RBKT       &kp LS(LBKT) &kp LS(RBKT)    &kp LS(N7) &kp LS(N8) &kp LS(MINUS)   &kp LS(EQUAL) &kp LSHFT       &kp LCTRL
            //       Magic                #          å          ¨              Å            ^               /          (          ?               `             Shift           Ctrl
            /* R5 */                                 &kp LS(N6) &trans         &trans                                  &trans     &kp LC(LS(TAB)) &kp LC(TAB)
            //                                       &          ▽              ▽                                       ▽          Ctrl+Shift+Tab  Ctrl+Tab
            /* T  */                                            &to LAYER_Base &trans       &trans          &trans     &trans     &trans
            //                                                  Base           ▽            ▽               ▽          ▽          ▽
            >;
        };

        layer_Magic {
            display-name = "Magic";
            bindings = <
            /*    left  C6 C5 C4 C3 C2 C1  |  right C1 C2 C3 C4 C5 C6  (thumbs: left T1 T2 T3 | right T3 T2 T1) */
            /* R1 */ &bt BT_CLR  &kp C_BRI_DN    &kp C_BRI_UP    &kp C_PREV      &kp C_NEXT      &kp C_PP           &kp C_MUTE &kp C_VOL_DN &kp C_VOL_UP &none &none &bt BT_CLR_ALL
            //       BT_clear    Bright_−        Bright_+        Prev_track      Next_track      Play/Pause         Mute       Vol_−        Vol_+        ·     ·     BT_clear_all
            /* R2 */ &bootloader &rgb_ug RGB_SPI &rgb_ug RGB_SAI &rgb_ug RGB_HUI &rgb_ug RGB_BRI &rgb_ug RGB_TOG    &none      &none        &none        &none &none &bootloader
            //       Boot        SPI             SAI             HUI             BRI             TOG                ·          ·            ·            ·     ·     Boot
            /* R3 */ &sys_reset  &rgb_ug RGB_SPD &rgb_ug RGB_SAD &rgb_ug RGB_HUD &rgb_ug RGB_BRD &rgb_ug RGB_EFF    &none      &none        &none        &none &none &sys_reset
            //       Reset       SPD             SAD             HUD             BRD             EFF                ·          ·            ·            ·     ·     Reset
            /* R4 */ &none       &none           &bt_0           &bt_1           &bt_2           &bt_3              &none      &none        &none        &none &none &to LAYER_Factory
            //       ·           ·               BT_0            BT_1            BT_2            BT_3               ·          ·            ·            ·     ·     Factory
            /* R5 */                             &out OUT_USB    &none           &none                                         &none        &none        &none
            //                                   USB             ·               ·                                             ·            ·            ·
            /* T  */                                             &none           &none           &none              &none      &none        &none
            //                                                   ·               ·               ·                  ·          ·            ·
            >;
        };

        layer_Factory {
            display-name = "Factory";
            bindings = <
            /*    left  C6 C5 C4 C3 C2 C1  |  right C1 C2 C3 C4 C5 C6  (thumbs: left T1 T2 T3 | right T3 T2 T1) */
            /* R1 */ &kp N0 &kp N4 &kp N8 &kp N3 &kp N8 &kp N3    &kp N3 &kp N8 &kp N3 &kp N8 &kp N4 &kp N0
            //       0      4      8      3      8      3         3      8      3      8      4      0
            /* R2 */ &kp N1 &kp N5 &kp N9 &kp N4 &kp N9 &kp N4    &kp N4 &kp N9 &kp N4 &kp N9 &kp N5 &kp N1
            //       1      5      9      4      9      4         4      9      4      9      5      1
            /* R3 */ &kp N2 &kp N6 &kp N0 &kp N5 &kp N0 &kp N5    &kp N5 &kp N0 &kp N5 &kp N0 &kp N6 &kp N2
            //       2      6      0      5      0      5         5      0      5      0      6      2
            /* R4 */ &kp N3 &kp N7 &kp N1 &kp N6 &kp N1 &kp N6    &kp N6 &kp N1 &kp N6 &kp N1 &kp N7 &kp N3
            //       3      7      1      6      1      6         6      1      6      1      7      3
            /* R5 */               &kp N2 &kp N7 &kp N2                  &kp N2 &kp N7 &kp N2
            //                     2      7      2                       2      7      2
            /* T  */                      &kp N7 &kp N8 &kp N9    &kp N9 &kp N8 &kp N7
            //                            7      8      9         9      8      7
            >;
        };
    };
};

// Trackpad settings (Layout Editor: input listeners)
&cirque_rh_listener {
    input-processors = <&zip_xy_scaler 3 1>;
    layer_2 {
        layers = <2>;
        input-processors = <&zip_xy_scaler 9 1>;
    };
};

&cirque_lh_listener {
    input-processors = <&zip_xy_scaler 5 9>, <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>, <&zip_xy_to_scroll_mapper>, <&zip_click_to_right_click_mapper>;
    layer_4 {
        layers = <4>;
        input-processors = <&zip_xy_scaler 3 1>;
    };
};

/* go60-config: custom devicetree */

/* go60-config: end of custom devicetree */
